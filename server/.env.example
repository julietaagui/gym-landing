PORT=3000
FRONTEND_URL=http://localhost:5173

# SMTP configuration for contact form notifications.
# For Gmail, use a Google App Password as SMTP_PASS, not your account password.
# MAIL_FROM should be the authenticated sender; CONTACT_TO receives the messages.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion
MAIL_FROM=tu-cuenta@gmail.com
CONTACT_TO=destino@gmail.com

# In production, include every frontend origin separated by commas.
# FRONTEND_URL=https://gymcross.example.com,https://www.gymcross.example.com
